---
import Layout from "../layouts/Layout.astro";
const allPosts = Object.values(
  import.meta.glob("./posts/*.md", { eager: true })
);

const descendingPosts = allPosts.sort((a: any, b: any) => {
  const dateA = new Date(a.frontmatter.pubDate);
  const dateB = new Date(b.frontmatter.pubDate);

  return dateA.getTime() + dateB.getTime();
});

function truncate(str: string, n: number) {
  return str.length > n ? str.substring(0, n - 1) + "..." : str;
}

console.log(descendingPosts);

const pageTitle = "Page Not Found";
---

<Layout title={pageTitle}>
  <div class="flex items-center justify-center flex-col my-10 font-mono">
    <h1 class="text-base text-white font-semibold">404</h1>
    <h1
      class="mt-2 text-4xl font-bold text-white tracking-tight sm:text-5xl mb-4"
    >
      Page not found.
    </h1>
    <a href="/" class="text-lg text-gray-400 font-bold mb-4"
      >Go back ~
      <span> →</span>
    </a>
  </div>
</Layout>
