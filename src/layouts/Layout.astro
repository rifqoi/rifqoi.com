---
import "@fontsource-variable/nunito";
import "@fontsource/ibm-plex-mono";
import "../styles/global.css";

import { fade } from "astro:transitions";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

import { ClientRouter } from "astro:transitions";
interface Props {
  title: string;
  compact?: boolean;
}

const { title, compact = false } = Astro.props;
---

<!doctype html>
<html lang="en" transition:name="root" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Rifqi Al Furqon's portfolio of site reliability engineering work, cloud-native projects, and learning notes."
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div
      class:list={[
        "container mx-auto flex max-w-[700px] flex-col p-8 pt-10 text-gray-400 md:p-4 md:pt-12",
        compact ? "" : "min-h-screen",
      ]}
    >
      <Header />
      <main
        transition:animate={fade({ duration: "0.4s" })}
        class:list={[
          "flex",
          compact ? "mt-7 mb-8" : "mt-7 mb-10 flex-1",
        ]}
      >
        <div class="font-sans w-full">
          <slot />
        </div>
      </main>
      <Footer />
    </div>
    <style is:global>
      html {
        font-family: system-ui, sans-serif;
        background: #111;
        height: 100%;
        width: 100%;
      }
      body {
        margin: 0;
      }
    </style>
  </body>
</html>
