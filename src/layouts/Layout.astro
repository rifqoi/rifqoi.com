---
import "@fontsource-variable/nunito";
import "@fontsource/ibm-plex-mono";
import "../styles/global.css";

import { fade } from "astro:transitions";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

import { ClientRouter } from "astro:transitions";
interface Props {
  title: string;
}

const currAge = new Date().getFullYear() - 2001;

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" transition:name="root" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content={`rifqoi, ${currAge}, linux nerds, mostly using bluish language, still trying out cool new things....`}
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <!-- class="flex items-center justify-center min-h-screen mx-auto max-w-[600px]
      md:p-4 md:pt-4 pt-10 p-8 text-gray-400" -->
    <div
      class="mx-auto max-w-[700px] container
      md:p-4 md:pt-12 pt-10 p-8 text-gray-400 min-h-screen flex flex-col"
    >
      <Header />
      <main
        transition:animate={fade({ duration: "0.4s" })}
        class="flex-1 mt-7 mb-10 flex"
      >
        <div class="font-sans w-full">
          <slot />
        </div>
      </main>
      <Footer />
    </div>
    <style is:global>
      html {
        font-family: system-ui, sans-serif;
        background: #111;
        height: 100%;
        width: 100%;
      }
      body {
        margin: 0;
      }
    </style>
  </body>
</html>
